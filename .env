# Ustawienia builda czytane przez Create React App.
# Dziala tak samo na Windowsie, Linuksie i w GitHub Actions - dlatego
# skrypty w package.json nie zawieraja juz windowsowego `set VAR=... &&`.

# Mapy zrodlowe zdradzaja caly kod na produkcji i wazyly wiecej niz sama strona.
GENERATE_SOURCEMAP=false
