# Wzor pliku .env - SKOPIUJ go jako `.env` i wpisz wartosci.
#
# Sam `.env` jest w .gitignore i NIE trafia do repozytorium. Na serwerze
# nie jest potrzebny - tam idzie juz gotowa, zbudowana strona. Te wartosci
# sa potrzebne tylko przy budowaniu: lokalnie u Ciebie i w GitHub Actions
# (tam siedza jako Secrets, nie jako plik).

# Publiczny identyfikator projektu w TinaCloud. Nie jest tajny - trafia
# do kodu panelu w przegladarce.
TINA_CLIENT_ID=58c8e337-68ae-496e-8906-02342256e45e

# Token tylko do odczytu, z panelu TinaCloud (zakladka Tokens).
# TO JEST SEKRET. Nie wklejaj go nigdzie poza tym plikiem i Secrets
# w GitHubie.
TINA_TOKEN=

# Galaz, do ktorej panel zapisuje zmiany.
GITHUB_BRANCH=main
