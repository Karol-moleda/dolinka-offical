---
import Base from '../layouts/Base.astro';
import Nawigacja from '../components/Nawigacja.astro';
import Naglowek from '../components/Naglowek.astro';
import Aktualnosci from '../components/Aktualnosci.astro';
import Kalendarz from '../components/Kalendarz.astro';
import ONas from '../components/ONas.astro';
import Dzialania from '../components/Dzialania.astro';
import Galeria from '../components/Galeria.astro';
import Zarzad from '../components/Zarzad.astro';
import Dokumenty from '../components/Dokumenty.astro';
import Kontakt from '../components/Kontakt.astro';
import Stopka from '../components/Stopka.astro';
---

<Base>
  <Nawigacja />

  <main id="tresc">
    <Naglowek />

    <Aktualnosci />
    <Kalendarz />
    <ONas />
    <Dzialania />
    <Galeria />
    <Zarzad />
    <Dokumenty />
    <Kontakt />
  </main>

  <Stopka />
</Base>
