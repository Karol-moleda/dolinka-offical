---
/**
 * Stopka.astro
 *
 * Celowo bardzo krotka. Byly tu wczesniej adres, e-mail i Facebook -
 * czyli dokladnie to samo, co w sekcji Kontakt tuz nad stopka. Te same
 * dane dwa razy pod soba nie dodaja niczego, a kaza mieszkancowi
 * zastanawiac sie, czy to na pewno to samo.
 *
 * Zostaje to, co do stopki naprawde nalezy: kto odpowiada za strone
 * i skrot z powrotem na gore.
 */
const rok = new Date().getFullYear();
---

<footer class="stopka">
  <div class="kontener stopka__wnetrze">
    <div>
      <p class="stopka__marka">Dolinka</p>
      <p class="stopka__podpis">
        © {rok} Zarząd Osiedla Młodych w Olkuszu
      </p>
    </div>

    {/* Na stronie glownej "#gora" to sekcja naglowka. Na podstronie
        ogloszenia tej sekcji nie ma, wiec kotwica prowadzilaby donikad -
        stad zapasowy element o tym samym identyfikatorze w Base.astro. */}
    <a class="stopka__gora" href="#gora">
      Na górę
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 19V5M6 11l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</footer>

<style>
  .stopka {
    /* Dolny odstep wiekszy o wysokosc przycisku "Dostepnosc", ktory jest
       przyklejony do dolu okna. Bez tego zaslania on przycisk "Na gore"
       dokladnie wtedy, gdy uzytkownik dojedzie na sam dol strony. */
    padding-block: var(--o-8) calc(var(--o-8) + 64px);
    background: var(--powierzchnia);
    border-top: 1px solid var(--linia);
  }

  .stopka__wnetrze {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--o-5);
  }

  .stopka__marka {
    font-family: var(--font-naglowki);
    font-weight: 800;
    font-size: var(--t-naglowek-s);
    line-height: 1.2;
  }

  .stopka__podpis {
    color: var(--tekst-3);
    font-size: var(--t-s);
  }

  .stopka__gora {
    display: inline-flex;
    align-items: center;
    gap: var(--o-2);
    /* 44px - cel dotykowy. */
    min-height: 44px;
    padding-inline: var(--o-4);
    border: 1px solid var(--linia-pole);
    border-radius: var(--r-pigulka);
    color: var(--tekst-2);
    font-size: var(--t-s);
    font-weight: 600;
    text-decoration: none;
  }

  .stopka__gora:hover {
    border-color: var(--marka);
    color: var(--marka);
  }

  .stopka__gora svg {
    width: 16px;
    height: 16px;
  }
</style>
