---
/**
 * Base.astro — wspolna rama kazdej strony: <head>, czcionki, motyw.
 * Sekcje trafiaja tu przez <slot />.
 */
import '../styles/tokens.css';
import '../styles/podstawy.css';
import '../styles/elementy.css';
import PanelDostepnosci from '../components/PanelDostepnosci.astro';

import { getImage } from 'astro:assets';
import { strona } from '../tresc.js';
import { obraz } from '../zdjecia.js';

const {
  title = 'Dolinka Olkusz | Wydarzenia, imprezy i aktualności Osiedla Młodych',
  description = 'Aktualności, kalendarz wydarzeń i galeria Osiedla Młodych w Olkuszu. Dolinka — miejsce spotkań mieszkańców.',
  /* Zdjecie podgladu przy udostepnianiu linku. Facebook i Messenger
     pokazuja je nad tytulem; link bez zdjecia to sam tekst, ktory ginie
     w potoku postow. Podstrona ogloszenia podaje tu swoj plakat,
     reszta strony dostaje zdjecie Dolinki. */
  obrazek,
  typ = 'website',
} = Astro.props;

const kanoniczny = new URL(Astro.url.pathname, Astro.site);

const domyslnyPodglad = await getImage({
  src: obraz(strona.naglowek.zdjecie),
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
  quality: 72,
});

// og:image musi byc adresem bezwzglednym - Facebook nie domysli sie
// domeny z "/_astro/dolinka.jpg".
const podgladPelny = new URL(obrazek ?? domyslnyPodglad.src, Astro.site).href;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={kanoniczny} />

    <meta property="og:type" content={typ} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={kanoniczny} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Dolinka Olkusz" />
    <meta property="og:image" content={podgladPelny} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* Bez tego X/Twitter pokazuje maly kwadracik zamiast szerokiego zdjecia. */}
    <meta name="twitter:card" content="summary_large_image" />

    {/* Kolor paska przegladarki na telefonie - osobno dla obu motywow. */}
    <meta name="theme-color" content="#f6f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e100f" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&display=swap"
    />

    {/*
      Ten skrypt MUSI byc w <head> i MUSI byc zwykly, nieprzetworzony
      (is:inline), zeby wykonal sie zanim przegladarka cokolwiek narysuje.
      Inaczej przy kazdym wejsciu na strone w trybie ciemnym mignie bialy
      ekran - dokladnie to robi dzisiejsza wersja, bo motyw ustawia sie
      dopiero po uruchomieniu Reacta.
    */}
    <script is:inline>
      (() => {
        try {
          // Motyw: 'light' | 'dark' | 'kontrast'. Brak wpisu = jak w systemie.
          const motyw = localStorage.getItem('dolinka-motyw');
          if (motyw === 'dark' || motyw === 'light' || motyw === 'kontrast') {
            document.documentElement.dataset.theme = motyw;
          }

          // Rozmiar tekstu: mnoznik, np. '1.35'.
          const skala = localStorage.getItem('dolinka-skala-tekstu');
          if (skala) {
            document.documentElement.style.setProperty('--skala-tekstu', skala);
          }

          // Zatrzymane animacje - ustawienie z panelu, niezalezne od systemu.
          if (localStorage.getItem('dolinka-bez-animacji') === '1') {
            document.documentElement.dataset.ruch = 'stop';
          }
        } catch (blad) {
          /* Tryb prywatny potrafi blokowac localStorage. Strona ma wtedy
             dzialac normalnie, tylko bez zapamietanego wyboru. */
        }
      })();
    </script>
  </head>

  <body>
    {/* Punkt zaczepienia dla "Na górę" ze stopki. Na stronie glownej ten
        identyfikator nosi sekcja naglowka, ale podstrony naglowka nie maja. */}
    <span id="gora" tabindex="-1"></span>
    <a class="pomin-nawigacje" href="#tresc">Przejdź do treści</a>
    <slot />
    <PanelDostepnosci />
  </body>
</html>
